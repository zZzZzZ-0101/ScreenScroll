{"manifest_version":3,"name":"ScreenScroll","description":"Capture whole web pages as clean multi-page PDFs. Offline, no ads.","version":"0.1.0","icons":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","128":"icon/128.png"},"content_security_policy":{"extension_pages":"script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"},"permissions":["activeTab","scripting","storage","unlimitedStorage","downloads","clipboardWrite","contextMenus"],"host_permissions":[],"optional_permissions":["debugger"],"optional_host_permissions":["<all_urls>"],"action":{"default_title":"ScreenScroll","default_popup":"popup.html"},"commands":{"capture-full":{"suggested_key":{"default":"Alt+Shift+P"},"description":"Capture full page"},"capture-selection":{"suggested_key":{"default":"Alt+Shift+S"},"description":"Capture a selection"},"capture-element":{"suggested_key":{"default":"Alt+Shift+E"},"description":"Capture an element"},"capture-visible":{"suggested_key":{"default":"Alt+Shift+V"},"description":"Capture visible area"}},"background":{"service_worker":"background.js"},"options_ui":{"open_in_tab":true,"page":"options.html"}}