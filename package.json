{
  "name": "screenscroll",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @screenscroll/extension dev",
    "build": "pnpm --filter @screenscroll/extension build",
    "build:e2e": "pnpm --filter @screenscroll/extension build:e2e",
    "zip": "pnpm --filter @screenscroll/extension zip",
    "test": "vitest run",
    "e2e": "pnpm build:e2e && playwright test",
    "fixtures": "node packages/fixtures/scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "ocr:bundle": "node scripts/ocr-bundle.mjs",
    "ocr:check": "OCR_BUNDLE=$(node scripts/ocr-bundle.mjs) vitest run packages/extension/test/ocr-model.test.ts",
    "dist": "pnpm build && node scripts/dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^5.7.284",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
