{
  "name": "scrollpress",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @scrollpress/extension dev",
    "build": "pnpm --filter @scrollpress/extension build",
    "build:e2e": "pnpm --filter @scrollpress/extension build:e2e",
    "zip": "pnpm --filter @scrollpress/extension zip",
    "test": "vitest run",
    "e2e": "pnpm build:e2e && playwright test",
    "fixtures": "node packages/fixtures/scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pdfjs-dist": "^5.7.284",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
